# Public endpoints, inlined into the static build. Copy to .env.local for local runs.
NEXT_PUBLIC_AGGREGATOR_API_HOST=https://getbze.com/api
NEXT_PUBLIC_BLOCKCHAIN_REST_API_HOST=https://rest.getbze.com

# Founding Program application form: an http(s) link opens it in a new tab, "soon" shows
# the program with a disabled "Coming soon" button, anything else (or unset) hides the
# program page, its Home section and its menu links.
NEXT_PUBLIC_FOUNDING_PROGRAM_URL=soon
